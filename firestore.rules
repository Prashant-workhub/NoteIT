rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User-owned data isolated strictly by authenticated User ID (uid)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Faculty profiles: public/student read for verified profiles, write only by owning faculty
    match /faculty_profiles/{facultyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == facultyId;
    }

    // Doubts collection: readable and writable by authenticated users
    match /doubts/{doubtId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.studentId == request.auth.uid || 
        resource.data.facultyId == request.auth.uid
      );
    }

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}